<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.javaup.mapper.ScheduleMapper">

    <resultMap id="BaseResultMap" type="org.javaup.entity.Schedule">
            <id property="id" column="id" />
            <result property="movieId" column="movie_id" />
            <result property="cinemaId" column="cinema_id" />
            <result property="hallId" column="hall_id" />
            <result property="startTime" column="start_time" />
            <result property="endTime" column="end_time" />
            <result property="price" column="price" />
            <result property="totalSeat" column="total_seat" />
            <result property="availableSeat" column="available_seat" />
            <result property="status" column="status" />
            <result property="version" column="version" />
            <result property="createdAt" column="created_at" />
            <result property="updatedAt" column="updated_at" />
    </resultMap>

    <sql id="Base_Column_List">
        id,movie_id,cinema_id,hall_id,start_time,end_time,
        price,total_seat,available_seat,status,version,
        created_at,updated_at
    </sql>

    <!-- 座位图元信息：场次 + 影厅 + 影院 + 影片，恒返回 1 行；座位由 schedule_seat 单独按 schedule_id 查询 -->
    <select id="selectSeatMapMeta" resultType="org.javaup.dto.movie.SeatMapRow">
        SELECT sc.id               AS scheduleId,
               sc.status           AS scheduleStatus,
               sc.start_time       AS startTime,
               sc.end_time         AS endTime,
               sc.price            AS price,
               h.name              AS hallName,
               h.row_count         AS rowCount,
               h.col_count         AS colCount,
               c.name              AS cinemaName,
               m.name              AS movieName
        FROM schedule sc
        LEFT JOIN hall h   ON h.id = sc.hall_id
        LEFT JOIN cinema c ON c.id = sc.cinema_id
        LEFT JOIN movie m  ON m.id = sc.movie_id
        WHERE sc.id = #{scheduleId}
    </select>
</mapper>
